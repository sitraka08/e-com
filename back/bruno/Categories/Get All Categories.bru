meta {
  name: Get All Categories
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/categories
  body: none
  auth: none
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  // Save first category ID
  if (res.body.data.length > 0) {
    bru.setEnvVar("categoryId", res.body.data[0].id);
  }
}
