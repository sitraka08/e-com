meta {
  name: Create Product
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Nouveau Produit Test",
    "description": "Description du produit de test",
    "price": 15000,
    "stock": 25,
    "categoryId": {{categoryId}},
    "images": [
      "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400",
      "https://images.unsplash.com/photo-1572635196237-14b3f281503f?w=400"
    ]
  }
}

docs {
  ## Création de produit avec images

  **Cette requête utilise le Mode JSON (URLs d'images) par défaut.**

  ### Mode 1: URLs d'images (JSON - PAR DÉFAUT)
  Les images sont des URLs hébergées (Unsplash, Cloudinary, etc.)
  ```json
  {
    "name": "Nouveau Produit",
    "description": "Description",
    "price": 15000,
    "stock": 25,
    "categoryId": 1,
    "images": [
      "https://images.unsplash.com/photo-xxx?w=400",
      "https://images.unsplash.com/photo-yyy?w=400"
    ]
  }
  ```

  ### Mode 2: Upload de fichiers locaux (FormData)
  Pour uploader des images depuis votre ordinateur:

  1. Changez le body type de "JSON" à "Multipart Form" dans Bruno
  2. Ajoutez les champs texte:
     - name: Nouveau Produit Test
     - description: Description
     - price: 15000
     - stock: 25
     - categoryId: 1
  3. Ajoutez des fichiers:
     - Cliquez sur "Add File"
     - Name: images (important!)
     - Sélectionnez une ou plusieurs images (max 5)
     - Formats: JPEG, PNG, GIF, WebP (max 5MB chacune)

  Les images uploadées seront stockées dans `/back/public/uploads/products/` et accessibles via:
  `http://localhost:3000/uploads/products/nom-fichier-unique.jpg`
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Product created", function() {
    expect(res.body.data).to.have.property('id');
    expect(res.body.data).to.have.property('name');
  });

  // Save new product ID
  bru.setEnvVar("newProductId", res.body.data.id);
}
