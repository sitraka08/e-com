meta {
  name: Search Products
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/products/search?q=laptop&page=1&limit=10
  body: none
  auth: none
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Has products array", function() {
    expect(res.body.data.items).to.be.an('array');
  });
}
