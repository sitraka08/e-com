meta {
  name: Set Default Address
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/addresses/{{addressId}}/set-default
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Address is default", function() {
    expect(res.body.data.isDefault).to.equal(true);
  });
}
