meta {
  name: Update Address
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/addresses/{{addressId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "label": "Bureau Principal",
    "phone": "+261340000002"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
