meta {
  name: Get All Orders
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/orders?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Has orders array", function() {
    expect(res.body.data.data).to.be.an('array');
  });
}
