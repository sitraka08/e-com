meta {
  name: Get Order Stats
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/orders/stats
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Has stats", function() {
    expect(res.body.data.totalOrders).to.exist;
    expect(res.body.data.totalRevenue).to.exist;
  });
}
