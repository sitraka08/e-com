meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "addressId": {{addressId}},
    "items": [
      {
        "productId": {{productId}},
        "quantity": 2
      }
    ],
    "deliveryFee": 3000,
    "paymentDetails": [
      {
        "paymentMethodId": {{paymentMethodId}},
        "amount": 5000,
        "transactionId": "TXN123456"
      }
    ]
  }
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });

  // Save order ID
  bru.setEnvVar("orderId", res.body.data.id);
}
