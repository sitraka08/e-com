meta {
  name: Update User
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "firstName": "Updated",
    "lastName": "Name"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
