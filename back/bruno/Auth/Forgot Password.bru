meta {
  name: Forgot Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "client@ecommerce.com"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response has OTP", function() {
    expect(res.body.data.otp).to.be.a('string');
  });

  // Save OTP for reset password
  bru.setEnvVar("otp", res.body.data.otp);
}
