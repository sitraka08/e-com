meta {
  name: Forgot Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "client@ecommerce.com"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response has success message", function() {
    expect(res.body.success).to.equal(true);
    expect(res.body.data.message).to.be.a('string');
    expect(res.body.data.message).to.include('Code de vérification envoyé');
  });

  test("Email sent successfully", function() {
    // Note: L'OTP n'est plus retourné dans la réponse pour des raisons de sécurité
    // Il est maintenant envoyé par email
    expect(res.body.data.message).to.exist;
  });
}
