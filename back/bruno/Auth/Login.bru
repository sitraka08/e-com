meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@ecommerce.com",
    "password": "Admin123!"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response has accessToken", function() {
    expect(res.body.data.tokens.accessToken).to.be.a('string');
  });

  // Save admin token
  bru.setEnvVar("adminToken", res.body.data.tokens.accessToken);
}
