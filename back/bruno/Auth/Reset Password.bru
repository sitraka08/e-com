meta {
  name: Reset Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "email": "client@ecommerce.com",
    "otp": "12345",
    "newPassword": "NewPassword123!"
  }
}

docs {
  # Reset Password Test

  Pour tester cette API, vous devez d'abord:
  1. Exécuter "Forgot Password" pour recevoir un OTP par email
  2. Vérifier votre email (sitrak.pro@gmail.com) pour obtenir le code OTP à 5 chiffres
  3. Remplacer "12345" dans le body ci-dessus par le code OTP reçu
  4. Exécuter cette requête Reset Password

  Note: L'OTP expire après 15 minutes.
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response is successful", function() {
    expect(res.body.success).to.equal(true);
  });

  test("Password reset confirmed", function() {
    // La réponse ne retourne rien (void), juste le succès
    expect(res.status).to.equal(200);
  });
}
