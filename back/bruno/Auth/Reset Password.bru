meta {
  name: Reset Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "email": "client@ecommerce.com",
    "otp": "{{otp}}",
    "newPassword": "NewPassword123!"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
