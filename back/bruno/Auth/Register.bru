meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "firstName": "John",
    "lastName": "Doe",
    "email": "john.doe@example.com",
    "password": "Password123!"
  }
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Response has accessToken", function() {
    expect(res.body.data.tokens.accessToken).to.be.a('string');
  });

  // Save token for next requests
  bru.setEnvVar("accessToken", res.body.data.tokens.accessToken);
  bru.setEnvVar("userId", res.body.data.user.id);
}
