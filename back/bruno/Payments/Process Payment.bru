meta {
  name: Process Payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/payments/process
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "orderId": {{orderId}},
    "payments": [
      {
        "paymentMethodId": {{paymentMethodId}},
        "amount": 5000,
        "transactionId": "TXN20251102001"
      }
    ]
  }
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Payments processed", function() {
    expect(res.body.data).to.be.an('array');
  });
}
