meta {
  name: Get Order Payments
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/payments/order/{{orderId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Has payments array", function() {
    expect(res.body.data).to.be.an('array');
  });
}
