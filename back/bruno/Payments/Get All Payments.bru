meta {
  name: Get All Payments
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/payments
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Has payments array", function() {
    expect(res.body.data).to.be.an('array');
  });
}
