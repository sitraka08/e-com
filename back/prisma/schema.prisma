generator client {
  provider = "prisma-client-js"
}

// datasource db {
//   provider = "mysql"
//   url      = env("DATABASE_URL")
// }

datasource db {
  provider = "postgresql" // Changez de "mysql" à "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VALIDATION
}

enum PaymentMethodType {
  MOBILE_MONEY
  BANK_CARD
  CASH
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SellerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          Int        @id @default(autoincrement())
  firstName   String     @db.VarChar(100)
  lastName    String     @db.VarChar(100)
  email       String     @unique @db.VarChar(255)
  password    String     @db.VarChar(255)
  role        UserRole   @default(CLIENT)
  status      UserStatus @default(PENDING_VALIDATION)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastLoginAt DateTime?

  addresses      Address[]
  paymentMethods PaymentMethod[]
  orders         Order[]
  otpResets      OtpReset[]
  seller         Seller?
  sellerRequests SellerRequest[]
  favorites      Favorite[]
  savedCarts     SavedCart[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model OtpReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  email     String   @db.VarChar(255)
  otp       String   @db.VarChar(6)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, otp])
  @@index([expiresAt])
  @@map("otp_resets")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  images      String   @db.Text
  categoryId  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seller     Seller?     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  favorites  Favorite[]
  sellerId   Int?

  @@index([categoryId])
  @@index([sellerId])
  @@index([isActive])
  @@index([name])
  @@map("products")
}

model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String   @db.VarChar(50)
  fullName   String   @db.VarChar(200)
  phone      String   @db.VarChar(20)
  street     String   @db.VarChar(255)
  city       String   @db.VarChar(100)
  region     String   @db.VarChar(100)
  postalCode String?  @db.VarChar(10)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

model PaymentMethod {
  id        Int               @id @default(autoincrement())
  userId    Int
  type      PaymentMethodType
  label     String            @db.VarChar(100)
  details   String            @db.Text
  isDefault Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([userId, isDefault])
  @@map("payment_methods")
}

model Order {
  id                Int         @id @default(autoincrement())
  orderNumber       String      @unique @db.VarChar(50)
  userId            Int
  addressId         Int
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  deliveryFee       Decimal     @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  totalPaid         Decimal     @default(0) @db.Decimal(10, 2)
  estimatedDelivery DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  address  Address     @relation(fields: [addressId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  productId       Int
  sellerId        Int
  productName     String  @db.VarChar(255)
  productImage    String  @db.VarChar(500)
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2)
  subtotal        Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller  Seller  @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
  @@map("order_items")
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int
  paymentMethodId Int
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  transactionId   String?       @unique @db.VarChar(100)
  metadata        String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

model Seller {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  storeName        String   @db.VarChar(200)
  storeDescription String?  @db.Text
  storeLogo        String?  @db.VarChar(500)
  commissionRate   Decimal  @default(0.10) @db.Decimal(5, 4)
  isApproved       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   Product[]
  orderItems OrderItem[]

  @@index([userId])
  @@index([isApproved])
  @@map("sellers")
}

model SellerRequest {
  id                   Int                 @id @default(autoincrement())
  userId               Int
  storeName            String              @db.VarChar(200)
  storeDescription     String              @db.Text
  businessRegistration String?             @db.VarChar(500)
  status               SellerRequestStatus @default(PENDING)
  rejectionReason      String?             @db.Text
  reviewedBy           Int?
  reviewedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("seller_requests")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

model SavedCart {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String   @db.VarChar(100)
  items     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_carts")
}
